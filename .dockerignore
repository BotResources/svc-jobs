# The binary is pre-compiled outside Docker (by scripts/publish.sh), so the
# target/ directory must be available in the build context. We only exclude
# development noise and explicitly keep `target/` out of the default-ignore
# set. Migrations are embedded in the binary at compile time, so nothing but
# the binary is copied in.

.git/
.env
README.md
LICENSE
CHANGELOG.md
.gitignore
.dockerignore
.github/
charts/
crates/
scripts/
Cargo.lock
Cargo.toml
deny.toml
